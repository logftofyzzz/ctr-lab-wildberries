# Для обычного запуска вставьте ключи в блок «Подключение API» веб-приложения.
# Они хранятся в локальном data/credentials.json.
# Не помещайте реальные ключи в этот файл.

# WB Content API: карточки товара и изменение фото.
WB_CONTENT_TOKEN=

# WB Promotion API: активные рекламные кампании и статистика.
WB_PROMOTION_TOKEN=

# Kie.ai: Nano Banana Pro image-to-image generation.
KIE_API_KEY=

# Приложение по умолчанию слушает только localhost:8787.
# CTR_LAB_PORT=8787
